{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd sarkari-update/frontend && npm install",
  "buildCommand": "cd sarkari-update/frontend && npm run build",
  "outputDirectory": "sarkari-update/frontend/dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
